{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "baseUrl": ".",
    "paths": {
      "akashic-dashboard": ["types/akashic-dashboard.d.ts"]
    },
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "frontend/dashboard/src/**/*.ts",
    "frontend/dashboard/src/**/*.tsx",
    "frontend/web/src/**/*.ts",
    "frontend/web/src/**/*.tsx",
    "plugins/**/*.ts",
    "types/**/*.d.ts"
  ]
}
